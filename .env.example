# Path to the private directory (defaults to <repo root>/private)
JOBAGENT_PRIVATE_DIR=private

# SQLite database file name (defaults to jobagent.db inside the private directory)
JOBAGENT_DB_FILE=jobagent.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (defaults to INFO)
JOBAGENT_LOG_LEVEL=INFO

# Resume PDF filename inside private/ (defaults to resume.pdf)
JOBAGENT_RESUME_FILE=resume.pdf

# LLM model for profile extraction (defaults to openai/gpt-oss-20b)
JOBAGENT_LLM_MODEL=openai/gpt-oss-20b

# Local embedding model (defaults to BAAI/bge-small-en-v1.5)
JOBAGENT_EMBED_MODEL=BAAI/bge-small-en-v1.5

# GROQ API key
GROQ_API_KEY=your_groq_api_key_here